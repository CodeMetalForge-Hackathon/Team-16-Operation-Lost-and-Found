[Unit]
Description=Team16 rfhits feed (wifi + bt + ble monitor)
After=network-online.target pod-bait.service rf-hub.service

[Service]
Type=simple
WorkingDirectory=/home/hacker/team16_sdr
# tcpdump (wifi feed) needs root; Alfa into monitor mode on ch1 (bait AP).
ExecStartPre=/usr/bin/bash -c 'nmcli device disconnect wlx00c0cabea289 2>/dev/null; ip link set wlx00c0cabea289 down; iw dev wlx00c0cabea289 set type monitor; ip link set wlx00c0cabea289 up; iw dev wlx00c0cabea289 set channel 1; true'
# Resolve the Realtek NIC's BT (0bda:c820) by USB ID, not hci index:
# the index shifts (hci1/hci2) with btusb load timing and what else
# is plugged in. '+' pre-start waits for it to enumerate.
ExecStartPre=/bin/sh -c 'timeout 30 sh -c "until find -L /sys/class/bluetooth -maxdepth 3 -name idProduct 2>/dev/null | xargs grep -l c820 2>/dev/null | grep -q .; do sleep 1; done" || true'
ExecStart=/usr/bin/bash -c 'A=""; for h in /sys/class/bluetooth/hci*; do [ -d "$$h" ] || continue; d=$$(readlink -f "$$h/device"); while [ "$$d" != "/" ] && [ ! -f "$$d/idProduct" ]; do d=$$(dirname "$$d"); done; [ -f "$$d/idProduct" ] && grep -q c820 "$$d/idProduct" && A=$$(basename "$$h") && break; done; exec /usr/bin/python3 /home/hacker/team16_sdr/monitor_scan.py --iface wlx00c0cabea289 --adapter "$${A:-hci2}" --out /home/hacker/team16_sdr/monitor_hits.jsonl'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
