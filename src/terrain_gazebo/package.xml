<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>terrain_gazebo</name>
  <version>0.1.0</version>
  <description>Headless Gazebo world that publishes a simulated 3D lidar over the synthetic hill.</description>
  <maintainer email="alexander_macconnell@student.uml.edu">Alexander MacConnell</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>terrain_localize</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
